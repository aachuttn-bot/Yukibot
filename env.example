# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token-here
# Your own Telegram user id (from @userinfobot) — enables /stats. Optional.
OWNER_ID=

# --- Chat text AI ---
# LLM_PROVIDER=openai  -> any OpenAI-compatible endpoint (needs LLM_API_KEY)
# LLM_PROVIDER=pollinations -> FREE, no key needed (owner pays $0; weaker model)
LLM_PROVIDER=pollinations
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# --- Pictures ---
# IMAGE_PROVIDER=pollinations -> FREE, no key needed (owner pays $0)
# IMAGE_PROVIDER=openai  -> any OpenAI-compatible /images endpoint (needs IMAGE_API_KEY)
IMAGE_PROVIDER=pollinations
# IMAGE_STYLE=photorealistic -> photo-like AI pics | anime -> illustrated style.
# Pics are always AI-generated fictional characters, never real people's photos.
IMAGE_STYLE=photorealistic
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_API_KEY=sk-your-key-here
IMAGE_MODEL=gpt-image-1
# --- Two-tier pictures: free trial sends "sample" pics, paid sessions use the
# --- main IMAGE_* provider above. Point IMAGE_* at a paid realistic endpoint
# --- later while trials stay free.
TRIAL_IMAGE_PROVIDER=pollinations
TRIAL_IMAGE_API_BASE=https://api.openai.com/v1
TRIAL_IMAGE_API_KEY=
TRIAL_IMAGE_MODEL=gpt-image-1

# --- Pricing ---
PRICE_STARS=300
SESSION_MINUTES=15
# Max AI pictures per paid session (bounds your image API bill)
PICS_PER_SESSION=10
# Every text reply also sends a fresh AI picture (text + pic together).
# Set to "false" for text-only replies with /pic on demand.
REPLY_WITH_PIC=true
